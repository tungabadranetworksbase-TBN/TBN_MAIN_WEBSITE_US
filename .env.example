# Copy to .env.local and fill in. .env.local is gitignored; never commit the
# real token, it is an agent credential with full access to the Chatwoot
# account. On Vercel these go in Project Settings -> Environment Variables.
#
# With any of these missing the contact form still validates and accepts the
# submission, it just logs instead of delivering - so local development works
# without credentials.

# Your Chatwoot instance, no trailing slash.
CHATWOOT_BASE_URL=https://chat.tungabadranetworks.in

# Chatwoot -> Profile Settings -> Access Token.
CHATWOOT_API_TOKEN=

# The number in the dashboard URL: /app/accounts/<id>/dashboard
CHATWOOT_ACCOUNT_ID=

# Settings -> Inboxes -> the inbox id in its URL. Create an API-channel inbox
# for this rather than reusing the website inbox, so form submissions and live
# chats stay separable.
CHATWOOT_INBOX_ID=
